# ============================================================
# Campus Placement — Backend stack (docker-compose.yml)
# Copy this file to `.env` (same directory as docker-compose.yml)
# and adjust the values below.
#
# NOTE: the compose file always connects to the bundled MongoDB container
# (MONGODB_URI=mongodb://mongodb:27017 is fixed inside docker-compose.yml).
# The MONGODB_URI / REDIS_URL in this .env are for local dev only and are
# NOT used by the containers — don't put localhost URLs here expecting the
# Docker stack to pick them up.
# ============================================================

# ---------- Database / cache ----------
DB_NAME=campusplace
# If MongoDB or Redis already run on the host (e.g. the Windows "MongoDB"
# service on 27017), use different host ports to avoid conflicts:
#   MONGO_PORT=27018
#   REDIS_PORT=6380
MONGO_PORT=27017
REDIS_PORT=6379

# ---------- Host port ----------
BACKEND_PORT=6005

# ---------- URLs ----------
# Origin the backend allows via CORS — must match the frontend URL you open
# in the browser. Comma-separate multiple origins if needed (e.g. Vercel
# preview domains). For the live deployment this is:
#   FRONTEND_URL=https://campus-placement-portal.vercel.app
FRONTEND_URL=http://localhost:8080
#
# --- Deployed on Render? ---
# Set these in the Render dashboard environment instead of .env:
#   FRONTEND_URL      https://campus-placement-portal.vercel.app
#   MONGODB_URI       your MongoDB Atlas connection string (no DB name suffix needed)
#   DB_NAME, SESSION_SECRET, ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET, ...
#   LOGTAIL_SOURCE_TOKEN   leave UNSET unless you have a valid Logtail token —
#                          an invalid one hangs the whole server
# Render injects its own PORT, and the Dockerfile's `npm start` picks it up.
#
# --- Want the Docker stack to use an external DB? ---
# Edit MONGODB_URI in Backend/docker-compose.yml (one line) to point at
# e.g. mongodb://host.docker.internal:27017 (host's MongoDB) or Atlas.

# ---------- Secrets (REQUIRED — change these before going live) ----------
SESSION_SECRET=change-me
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRY=7d

# ---------- Optional integrations (leave blank to disable) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOGTAIL_SOURCE_TOKEN=

# ---------- Code execution (Piston + Judge0 + OneCompiler failover) ----------
# In the Docker stack these point at the bundled containers; for local dev
# without Docker, point at your own instances or leave blank and rely on
# Judge0 (if configured) — note the public emkc.org Piston API now requires
# an authorization key (PISTON_API_KEY) obtained from the maintainers.
PISTON_API_URL=http://piston:2000/api/v2/piston/execute
# Optional: authorization key for the public/community Piston endpoints
# (emkc.org requires one since Feb 2026). Leave blank for self-hosted only.
PISTON_API_KEY=
JUDGE0_API_URL=http://judge0:2358
# Optional: send this as the X-Auth-Token header to Judge0 when auth is
# enabled in judge0.conf (JUDGE0_AUTHENTICATION_BASE64).
JUDGE0_AUTH_TOKEN=
# OneCompiler free public API (no key). Override only if you proxy/self-host.
ONECOMPILER_API_URL=https://onecompiler.com/api/console/run
# Failover order — comma-separated engine names:
#   self_piston, judge0, public_piston, community_piston, onecompiler
CODE_EXECUTION_ENGINES=self_piston,judge0,public_piston,community_piston,onecompiler

# ---------- File scanning (ClamAV) ----------
# CLAMAV_HOST unset  → scanning disabled (uploads pass through).
# CLAMAV_FAIL_OPEN   → false (default): reject uploads when clamd is
#                      unreachable; true: log and allow.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false
MAX_UPLOAD_MB=10

# ---------- Email (deadline reminders) — nodemailer + Resend failover ----------
# At least one provider must be configured for the deadline-reminder job.
# Providers are tried in MAIL_PROVIDER_ORDER; the first that succeeds wins.
#
# nodemailer via SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPlace <no-reply@yourdomain.com>
#
# Resend (https://resend.com — API key from the dashboard):
RESEND_API_KEY=
# Resend only lets you send from a domain verified in its dashboard; the
# sandbox (test) key is restricted to onboarding@resend.dev.
RESEND_FROM=onboarding@resend.dev
# Failover order — comma-separated: nodemailer, resend
MAIL_PROVIDER_ORDER=nodemailer,resend

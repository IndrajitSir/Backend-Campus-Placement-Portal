# ============================================================================
# CampusPlace — PRODUCTION environment template (backend)
# Copy to .env.production (the real file is git-ignored), fill in values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# The same file drives both docker-compose interpolation (${VAR}) and the
# backend container's runtime env (env_file). Restrict access (chmod 600).
# ============================================================================

# --- Core ---
NODE_ENV=production
PORT=6005

# MongoDB Atlas — paste the full SRV URI. Do NOT append the DB name; the
# backend appends DB_NAME safely when a query string is present.
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=campusplace

# Upstash Redis — rediss:// (TLS) is supported natively by ioredis, no code change.
#   rediss://default:TOKEN@YOUR-INSTANCE.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-INSTANCE.upstash.io:6379

# --- CORS / frontend ---
# Public origin of the deployed frontend (must match the browser's URL).
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN.com
CORS_ORIGIN=https://YOUR-FRONTEND-DOMAIN.com
# Baked into the frontend bundle at build time (docker-compose.prod.yml arg):
VITE_API_URL=https://YOUR-BACKEND-DOMAIN.com

# --- Auth secrets (generate strong values!) ---
#   openssl rand -base64 64
SESSION_SECRET=CHANGE_ME
ACCESS_TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_EXPIRY=7d

# --- OAuth (optional — leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Logging ---
LOGTAIL_SOURCE_TOKEN=

# --- Code execution ---
# Points at the bundled Piston service in compose; set to a hosted endpoint
# (and remove the piston service) if you use a managed sandbox.
PISTON_API_URL=http://piston:2000/api/v2/piston/execute
# Optional: authorization key for the public/community Piston endpoints
# (emkc.org requires one since Feb 2026). Leave blank for self-hosted only.
PISTON_API_KEY=
# Judge0 engine (second code-execution engine; Piston and Judge0 co-exist
# and the backend fails over automatically).
JUDGE0_API_URL=http://judge0:2358
# Optional: X-Auth-Token for Judge0 when auth is enabled in judge0.conf.
JUDGE0_AUTH_TOKEN=
# OneCompiler free public API (no key). Override only if you proxy/self-host.
ONECOMPILER_API_URL=https://onecompiler.com/api/console/run
# Failover order — comma-separated:
#   self_piston, judge0, public_piston, community_piston, onecompiler
CODE_EXECUTION_ENGINES=self_piston,judge0,public_piston,community_piston,onecompiler

# --- File scanning (ClamAV) ---
# Unset CLAMAV_HOST only if you intentionally disable upload scanning.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# false = reject uploads if clamd is unreachable (secure default); true = allow
CLAMAV_FAIL_OPEN=false
MAX_UPLOAD_MB=10

# --- Deadline reminders (optional — leave blank to disable) ---
# Providers are tried in MAIL_PROVIDER_ORDER; the first that succeeds wins.
# nodemailer via SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPlace <no-reply@YOUR-DOMAIN.com>
# Resend (https://resend.com — API key from the dashboard):
RESEND_API_KEY=
# Resend only lets you send from a domain verified in its dashboard; the
# sandbox (test) key is restricted to onboarding@resend.dev.
RESEND_FROM=onboarding@resend.dev
# Failover order — comma-separated: nodemailer, resend
MAIL_PROVIDER_ORDER=nodemailer,resend

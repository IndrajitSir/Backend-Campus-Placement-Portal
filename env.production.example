# ============================================================================
# CampusPlace — PRODUCTION environment template (backend)
# Copy to .env.production (the real file is git-ignored), fill in values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# The same file drives both docker-compose interpolation (${VAR}) and the
# backend container's runtime env (env_file). Restrict access (chmod 600).
# ============================================================================

# --- Core ---
NODE_ENV=production
PORT=6005

# MongoDB Atlas — paste the full SRV URI. Do NOT append the DB name; the
# backend appends DB_NAME safely when a query string is present.
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=campusplace

# Upstash Redis — rediss:// (TLS) is supported natively by ioredis, no code change.
#   rediss://default:TOKEN@YOUR-INSTANCE.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-INSTANCE.upstash.io:6379

# --- CORS / frontend ---
# Public origin of the deployed frontend (must match the browser's URL).
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN.com
CORS_ORIGIN=https://YOUR-FRONTEND-DOMAIN.com
# Baked into the frontend bundle at build time (docker-compose.prod.yml arg):
VITE_API_URL=https://YOUR-BACKEND-DOMAIN.com

# --- Auth secrets (generate strong values!) ---
#   openssl rand -base64 64
SESSION_SECRET=CHANGE_ME
ACCESS_TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_EXPIRY=7d

# --- OAuth (optional — leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Logging ---
LOGTAIL_SOURCE_TOKEN=

# --- Code execution ---
# Points at the bundled Piston service in compose; set to a hosted endpoint
# (and remove the piston service) if you use a managed sandbox.
PISTON_API_URL=http://piston:2000/api/v2/piston/execute

# --- Deadline reminders (optional — leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPlace <no-reply@YOUR-DOMAIN.com>
